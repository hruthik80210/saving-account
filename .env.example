# ==============================================================================
# Savings Account Interest Calculator - Environment Configuration
# ==============================================================================

# Application
APP_NAME="Savings Account Interest Calculator"
APP_VERSION="1.0.0"
DEBUG=true

# Database Connection
# Default for immediate zero-config local run:
DATABASE_URL=sqlite:///./savings_calculator.db

# For Supabase PostgreSQL (Production / Direct connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Supabase Connection Pooler (Transaction mode):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Authentication & API Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-verification

# Banking Interest Engine Defaults
DEFAULT_DAY_COUNT_CONVENTION=ACTUAL_365
ROUNDING_MODE=HALF_UP
ALLOW_NEGATIVE_BALANCE=false

# Static / Demo Data Seeding
# Set AUTO_SEED_DEMO_DATA=false to start the server with a completely empty
# business database (only the records you create are kept). Seeded demo data can
# also be removed at runtime from the Settings page or via
# DELETE /api/database/purge-static and DELETE /api/database/purge-all.
AUTO_SEED_DEMO_DATA=true
SEED_DEFAULT_SLABS=true

# Frontend Configuration (in frontend/.env)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
